# Environment Configuration Example for Server
PORT=5001
NODE_ENV=production

# PostgreSQL Database (Supabase, Neon, Railway, or local)
# For Supabase with PgBouncer:
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://user:password@localhost:5432/mygate"

# JWT Secret Key (generate a strong random string)
JWT_SECRET="generate-a-very-secure-random-string-min-32-chars"

# Allowed Client URLs for CORS (comma-separated if multiple)
# In production, set to your Vercel/custom domain: https://royalorchid.vercel.app
CLIENT_URL="http://localhost:5173,http://localhost:5001"
